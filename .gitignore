# Local environment — contains machine-specific paths (e.g. TEENYC_PATH). Copy
# .env.dev (tracked) to .env and customize; .env itself stays untracked.
.env

# Generated by Cargo
# will have compiled files and executables
debug
target

# vision-rs itself is a library crate -- consumers resolve their own
# dependency versions, so its own Cargo.lock shouldn't be tracked (unlike
# an application). Anchored to the repo root only: demos/parking_garage is
# a separate standalone application and should keep committing its own.
/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Model weight files
*.pt

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Beads (br) files — private beads/ repo, not tracked here
.beads

# mdBook build output
/book/book/

# docs-site build output
/docs-site/dist/
