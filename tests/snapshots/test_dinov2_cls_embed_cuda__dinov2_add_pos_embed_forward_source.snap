"pub fn dinov2_add_pos_embed < T : Triton, const D : i32 >\n(in_ptr : T :: Pointer < f32 > , pos_ptr : T :: Pointer < f32 > , out_ptr : T\n:: Pointer < f32 > , n_seq : i32,) where T :: I32Tensor : Tensor < i32, 1 > ,\nT :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nPointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor <\nT :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let d = T :: arange(0, D); let b =\n    pid / n_seq; let n = pid - b * n_seq; let tok_base = (b * n_seq + n) * D;\n    let pos_base = n * D; let x = T ::\n    load(in_ptr.add_offsets(d + tok_base), None, None, & [], None, None, None,\n    false); let pe = T ::\n    load(pos_ptr.add_offsets(d + pos_base), None, None, & [], None, None,\n    None, false); T ::\n    store(out_ptr.add_offsets(d + tok_base), x + pe, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(in_ptr: *mut f32, pos_ptr: *mut f32, out_ptr: *mut f32, n_seq: i32) {\n    let in_ptr = LlvmPointer(in_ptr as *mut _);\n    let pos_ptr = LlvmPointer(pos_ptr as *mut _);\n    let out_ptr = LlvmPointer(out_ptr as *mut _);\n    dinov2_add_pos_embed::<LlvmTriton, 64>(in_ptr, pos_ptr, out_ptr, n_seq);\n}"
