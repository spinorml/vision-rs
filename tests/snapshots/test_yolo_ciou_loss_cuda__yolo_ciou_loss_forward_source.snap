"pub fn yolo_ciou_loss_forward < T : Triton, D : Float, const BLOCK_N : i32 >\n(pred_ptr : T :: Pointer < D > , target_ptr : T :: Pointer < D > , loss_ptr :\nT :: Pointer < D > , iou_ptr : T :: Pointer < D > , v_ptr : T :: Pointer < D >\n, alpha_ptr : T :: Pointer < D > , N : i32,) where T :: I32Tensor : types ::\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < D > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let n_start = T :: program_id(Axis :: X) * BLOCK_N; let n_offs = T ::\n    arange(0, BLOCK_N) + n_start; let mask = n_offs.lt(N); let zeros = T ::\n    zeros :: < D > (& [BLOCK_N]); let px = T ::\n    load(pred_ptr.add_offsets(n_offs + 0 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let py = T ::\n    load(pred_ptr.add_offsets(n_offs + 1 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let pw = T ::\n    load(pred_ptr.add_offsets(n_offs + 2 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let ph = T ::\n    load(pred_ptr.add_offsets(n_offs + 3 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let tx = T ::\n    load(target_ptr.add_offsets(n_offs + 0 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let ty = T ::\n    load(target_ptr.add_offsets(n_offs + 1 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let tw = T ::\n    load(target_ptr.add_offsets(n_offs + 2 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let th = T ::\n    load(target_ptr.add_offsets(n_offs + 3 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let half = T ::\n    full(& [BLOCK_N], D :: from_f64(0.5)); let eps = T ::\n    full(& [BLOCK_N], D :: from_f64(1e-7)); let ones = T ::\n    full(& [BLOCK_N], D :: from_f64(1.0)); let px1 = px - pw * half; let px2 =\n    px + pw * half; let py1 = py - ph * half; let py2 = py + ph * half; let\n    tx1 = tx - tw * half; let tx2 = tx + tw * half; let ty1 = ty - th * half;\n    let ty2 = ty + th * half; let ix1 = T :: maximum(px1, tx1); let ix2 = T ::\n    minimum(px2, tx2); let iy1 = T :: maximum(py1, ty1); let iy2 = T ::\n    minimum(py2, ty2); let inter_w = T :: maximum(ix2 - ix1, zeros); let\n    inter_h = T :: maximum(iy2 - iy1, zeros); let inter = inter_w * inter_h;\n    let pred_area = pw * ph; let target_area = tw * th; let union = pred_area\n    + target_area - inter; let iou = inter / (union + eps); let dx = px - tx;\n    let dy = py - ty; let d2 = dx * dx + dy * dy; let ex1 = T ::\n    minimum(px1, tx1); let ex2 = T :: maximum(px2, tx2); let ey1 = T ::\n    minimum(py1, ty1); let ey2 = T :: maximum(py2, ty2); let ecw = ex2 - ex1;\n    let ech = ey2 - ey1; let c2 = ecw * ecw + ech * ech; let atan_t = T ::\n    atan(tw / (th + eps)); let atan_p = T :: atan(pw / (ph + eps)); let diff =\n    atan_t - atan_p; let pi2_inv4 = T ::\n    full(& [BLOCK_N], D :: from_f64(0.405_284_73)); let v = pi2_inv4 * diff *\n    diff; let alpha = v / (ones - iou + v + eps); T ::\n    store(iou_ptr.add_offsets(n_offs), iou, Some(mask), & [], None, None); T\n    :: store(v_ptr.add_offsets(n_offs), v, Some(mask), & [], None, None); T ::\n    store(alpha_ptr.add_offsets(n_offs), alpha, Some(mask), & [], None, None);\n    let loss = ones - iou + d2 / (c2 + eps) + alpha * v; T ::\n    store(loss_ptr.add_offsets(n_offs), loss, Some(mask), & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn yolo_ciou_loss_forward_entry_point(pred_ptr: *mut f32, target_ptr: *mut f32, loss_ptr: *mut f32, iou_ptr: *mut f32, v_ptr: *mut f32, alpha_ptr: *mut f32, N: i32) {\n    let pred_ptr = LlvmPointer(pred_ptr as *mut _);\n    let target_ptr = LlvmPointer(target_ptr as *mut _);\n    let loss_ptr = LlvmPointer(loss_ptr as *mut _);\n    let iou_ptr = LlvmPointer(iou_ptr as *mut _);\n    let v_ptr = LlvmPointer(v_ptr as *mut _);\n    let alpha_ptr = LlvmPointer(alpha_ptr as *mut _);\n    yolo_ciou_loss_forward::<LlvmTriton, f32, 32>(pred_ptr, target_ptr, loss_ptr, iou_ptr, v_ptr, alpha_ptr, N);\n}"
