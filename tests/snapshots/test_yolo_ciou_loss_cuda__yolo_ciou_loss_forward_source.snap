"pub fn yolo_ciou_loss_forward < T : Triton, const BLOCK_N : i32 >\n(pred_ptr : T :: Pointer < f32 > , target_ptr : T :: Pointer < f32 > ,\nloss_ptr : T :: Pointer < f32 > , N : i32,) where T :: I32Tensor : types ::\nTensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let n_start = T :: program_id(Axis :: X) * BLOCK_N; let n_offs = T ::\n    arange(0, BLOCK_N) + n_start; let mask = n_offs.lt(N); let zeros = T ::\n    zeros :: < f32 > (& [BLOCK_N]); let px = T ::\n    load(pred_ptr.add_offsets(n_offs + 0 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let py = T ::\n    load(pred_ptr.add_offsets(n_offs + 1 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let pw = T ::\n    load(pred_ptr.add_offsets(n_offs + 2 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let ph = T ::\n    load(pred_ptr.add_offsets(n_offs + 3 * N), Some(mask), Some(zeros), & [],\n    None, None, None, false); let tx = T ::\n    load(target_ptr.add_offsets(n_offs + 0 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let ty = T ::\n    load(target_ptr.add_offsets(n_offs + 1 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let tw = T ::\n    load(target_ptr.add_offsets(n_offs + 2 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let th = T ::\n    load(target_ptr.add_offsets(n_offs + 3 * N), Some(mask), Some(zeros), &\n    [], None, None, None, false); let half = T :: full :: < f32 >\n    (& [BLOCK_N], 0.5f32); let eps = T :: full :: < f32 >\n    (& [BLOCK_N], 1e-7f32); let ones = T :: full :: < f32 >\n    (& [BLOCK_N], 1.0f32); let px1 = px - pw * half; let px2 = px + pw * half;\n    let py1 = py - ph * half; let py2 = py + ph * half; let tx1 = tx - tw *\n    half; let tx2 = tx + tw * half; let ty1 = ty - th * half; let ty2 = ty +\n    th * half; let ix1 = T :: maximum(px1, tx1); let ix2 = T ::\n    minimum(px2, tx2); let iy1 = T :: maximum(py1, ty1); let iy2 = T ::\n    minimum(py2, ty2); let inter_w = T :: maximum(ix2 - ix1, zeros); let\n    inter_h = T :: maximum(iy2 - iy1, zeros); let inter = inter_w * inter_h;\n    let pred_area = pw * ph; let target_area = tw * th; let union = pred_area\n    + target_area - inter; let iou = inter / (union + eps); let dx = px - tx;\n    let dy = py - ty; let d2 = dx * dx + dy * dy; let ex1 = T ::\n    minimum(px1, tx1); let ex2 = T :: maximum(px2, tx2); let ey1 = T ::\n    minimum(py1, ty1); let ey2 = T :: maximum(py2, ty2); let ecw = ex2 - ex1;\n    let ech = ey2 - ey1; let c2 = ecw * ecw + ech * ech; let atan_t = T ::\n    atan(tw / (th + eps)); let atan_p = T :: atan(pw / (ph + eps)); let diff =\n    atan_t - atan_p; let pi2_inv4 = T :: full :: < f32 >\n    (& [BLOCK_N], 0.405_284_73_f32); let v = pi2_inv4 * diff * diff; let alpha\n    = v / (ones - iou + v + eps); let loss = ones - iou + d2 / (c2 + eps) +\n    alpha * v; T ::\n    store(loss_ptr.add_offsets(n_offs), loss, Some(mask), & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(pred_ptr: *mut f32, target_ptr: *mut f32, loss_ptr: *mut f32, N: i32) {\n    let pred_ptr = LlvmPointer(pred_ptr as *mut _);\n    let target_ptr = LlvmPointer(target_ptr as *mut _);\n    let loss_ptr = LlvmPointer(loss_ptr as *mut _);\n    yolo_ciou_loss_forward::<LlvmTriton, 32>(pred_ptr, target_ptr, loss_ptr, N);\n}"
