"pub fn dinov2_pack_qkv_backward < T : Triton, const HEAD_DIM : i32 >\n(d_packed_ptr : T :: Pointer < f32 > , d_qkv_ptr : T :: Pointer < f32 > ,\nn_ctx : i32, num_heads : i32, bh_total : i32,) where T :: I32Tensor : Tensor <\ni32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > ,\nT :: Pointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor, Output = T ::\nTensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let d = T :: arange(0, HEAD_DIM);\n    let s = pid / (bh_total * n_ctx); let bh = (pid / n_ctx) - s * bh_total;\n    let n = pid - (s * bh_total + bh) * n_ctx; let b = bh / num_heads; let h =\n    bh - b * num_heads; let src_base = (s * bh_total + bh) * n_ctx * HEAD_DIM\n    + n * HEAD_DIM; let dx = T ::\n    load(d_packed_ptr.add_offsets(d + src_base), None, None, & [], None, None,\n    None, false); let dst_base = b * n_ctx * 3 * num_heads * HEAD_DIM + n * 3\n    * num_heads * HEAD_DIM + s * num_heads * HEAD_DIM + h * HEAD_DIM; T ::\n    store(d_qkv_ptr.add_offsets(d + dst_base), dx, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(d_packed_ptr: *mut f32, d_qkv_ptr: *mut f32, n_ctx: i32, num_heads: i32, bh_total: i32) {\n    let d_packed_ptr = LlvmPointer(d_packed_ptr as *mut _);\n    let d_qkv_ptr = LlvmPointer(d_qkv_ptr as *mut _);\n    dinov2_pack_qkv_backward::<LlvmTriton, 32>(d_packed_ptr, d_qkv_ptr, n_ctx, num_heads, bh_total);\n}"
