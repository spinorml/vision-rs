"pub fn pack_heads < T : Triton, const HEAD_DIM : i32 >\n(inp_ptr : T :: Pointer < f32 > , out_ptr : T :: Pointer < f32 > , n_heads :\ni32, s : i32,) where T :: I32Tensor : Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < f32 > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < f32\n> > > ,\n{\n    let pid = T :: program_id(Axis :: X); let hd = T :: arange(0, HEAD_DIM);\n    let d = n_heads * HEAD_DIM; let bh = pid / s; let si = pid - bh * s; let b\n    = bh / n_heads; let h = bh - b * n_heads; let in_base = (b * s + si) * d +\n    h * HEAD_DIM; let out_base = (bh * s + si) * HEAD_DIM; let x = T ::\n    load(inp_ptr.add_offsets(hd + in_base), None, None, & [], None, None,\n    None, false); T ::\n    store(out_ptr.add_offsets(hd + out_base), x, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(inp_ptr: *mut f32, out_ptr: *mut f32, n_heads: i32, s: i32) {\n    let inp_ptr = LlvmPointer(inp_ptr as *mut _);\n    let out_ptr = LlvmPointer(out_ptr as *mut _);\n    pack_heads::<LlvmTriton, 32>(inp_ptr, out_ptr, n_heads, s);\n}"
