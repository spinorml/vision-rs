"pub fn dinov2_remove_cls < T : Triton, const D : i32 >\n(in_ptr : T :: Pointer < f32 > , out_ptr : T :: Pointer < f32 > , n_seq :\ni32,) where T :: I32Tensor : Tensor < i32, 1 > , T :: I32Tensor : Comparison <\ni32, BoolTensor = T :: BoolTensor > , T :: Pointer < f32 > : AddOffsets < i32,\n1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let d = T :: arange(0, D); let n_out\n    = n_seq + 1; let b = pid / n_seq; let n = pid - b * n_seq; let in_base =\n    (b * n_out + n + 1) * D; let out_base = (b * n_seq + n) * D; let x = T ::\n    load(in_ptr.add_offsets(d + in_base), None, None, & [], None, None, None,\n    false); T ::\n    store(out_ptr.add_offsets(d + out_base), x, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(in_ptr: *mut f32, out_ptr: *mut f32, n_seq: i32) {\n    let in_ptr = LlvmPointer(in_ptr as *mut _);\n    let out_ptr = LlvmPointer(out_ptr as *mut _);\n    dinov2_remove_cls::<LlvmTriton, 64>(in_ptr, out_ptr, n_seq);\n}"
