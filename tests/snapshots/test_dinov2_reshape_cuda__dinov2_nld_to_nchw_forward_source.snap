"pub fn dinov2_nld_to_nchw < T : Triton, const D : i32 >\n(in_ptr : T :: Pointer < f32 > , out_ptr : T :: Pointer < f32 > , n_spatial :\ni32,) where T :: I32Tensor : Tensor < i32, 1 > , T :: I32Tensor : Comparison <\ni32, BoolTensor = T :: BoolTensor > , T :: Pointer < f32 > : AddOffsets < i32,\n1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let d = T :: arange(0, D); let b =\n    pid / n_spatial; let n = pid - b * n_spatial; let in_base =\n    (b * n_spatial + n) * D; let x = T ::\n    load(in_ptr.add_offsets(d + in_base), None, None, & [], None, None, None,\n    false); let out_base = b * D * n_spatial + n; T ::\n    store(out_ptr.add_offsets(d * n_spatial + out_base), x, None, & [], None,\n    None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(in_ptr: *mut f32, out_ptr: *mut f32, n_spatial: i32) {\n    let in_ptr = LlvmPointer(in_ptr as *mut _);\n    let out_ptr = LlvmPointer(out_ptr as *mut _);\n    dinov2_nld_to_nchw::<LlvmTriton, 64>(in_ptr, out_ptr, n_spatial);\n}"
