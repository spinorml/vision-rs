"pub fn dinov2_pack_qkv < T : Triton, const HEAD_DIM : i32 >\n(qkv_ptr : T :: Pointer < f32 > , packed_ptr : T :: Pointer < f32 > , n_ctx :\ni32, num_heads : i32, bh_total : i32,) where T :: I32Tensor : Tensor < i32, 1\n> , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nPointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor <\nT :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let d = T :: arange(0, HEAD_DIM);\n    let s = pid / (bh_total * n_ctx); let bh = (pid / n_ctx) - s * bh_total;\n    let n = pid - (s * bh_total + bh) * n_ctx; let b = bh / num_heads; let h =\n    bh - b * num_heads; let src_base = b * n_ctx * 3 * num_heads * HEAD_DIM +\n    n * 3 * num_heads * HEAD_DIM + s * num_heads * HEAD_DIM + h * HEAD_DIM;\n    let x = T ::\n    load(qkv_ptr.add_offsets(d + src_base), None, None, & [], None, None,\n    None, false); let dst_base = (s * bh_total + bh) * n_ctx * HEAD_DIM + n *\n    HEAD_DIM; T ::\n    store(packed_ptr.add_offsets(d + dst_base), x, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(qkv_ptr: *mut f32, packed_ptr: *mut f32, n_ctx: i32, num_heads: i32, bh_total: i32) {\n    let qkv_ptr = LlvmPointer(qkv_ptr as *mut _);\n    let packed_ptr = LlvmPointer(packed_ptr as *mut _);\n    dinov2_pack_qkv::<LlvmTriton, 32>(qkv_ptr, packed_ptr, n_ctx, num_heads, bh_total);\n}"
