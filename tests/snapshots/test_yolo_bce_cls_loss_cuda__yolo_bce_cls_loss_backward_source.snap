"pub fn yolo_bce_cls_loss_backward < T : Triton, D : Float, const BLOCK_N : i32\n>\n(dy_ptr : T :: Pointer < D > , pred_ptr : T :: Pointer < D > , target_ptr : T\n:: Pointer < D > , d_pred_ptr : T :: Pointer < D > , N : i32, C : i32,) where\nT :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor : Comparison <\ni32, BoolTensor = T :: BoolTensor > , T :: Pointer < D > : AddOffsets < i32,\n1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < D > > > ,\n{\n    let n_start = T :: program_id(Axis :: X) * BLOCK_N; let n_offs = T ::\n    arange(0, BLOCK_N) + n_start; let mask = n_offs.lt(N); let zeros = T ::\n    zeros :: < D > (& [BLOCK_N]); let ones = T ::\n    full(& [BLOCK_N], D :: from_f64(1.0)); let neg_one = T ::\n    full(& [BLOCK_N], D :: from_f64(- 1.0)); let dy = T ::\n    load(dy_ptr.add_offsets(n_offs), Some(mask), Some(zeros), & [], None,\n    None, None, false); let mut c : i32 = 0; while c < C\n    {\n        let base = c * N; let x = T ::\n        load(pred_ptr.add_offsets(n_offs + base), Some(mask), Some(zeros), &\n        [], None, None, None, false); let t = T ::\n        load(target_ptr.add_offsets(n_offs + base), Some(mask), Some(zeros), &\n        [], None, None, None, false); let sig = ones /\n        (ones + T :: exp(neg_one * x)); let grad = dy * (sig - t); T ::\n        store(d_pred_ptr.add_offsets(n_offs + base), grad, Some(mask), & [],\n        None, None); c += 1;\n    }\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn yolo_bce_cls_loss_backward_entry_point(dy_ptr: *mut f32, pred_ptr: *mut f32, target_ptr: *mut f32, d_pred_ptr: *mut f32, N: i32, C: i32) {\n    let dy_ptr = LlvmPointer(dy_ptr as *mut _);\n    let pred_ptr = LlvmPointer(pred_ptr as *mut _);\n    let target_ptr = LlvmPointer(target_ptr as *mut _);\n    let d_pred_ptr = LlvmPointer(d_pred_ptr as *mut _);\n    yolo_bce_cls_loss_backward::<LlvmTriton, f32, 32>(dy_ptr, pred_ptr, target_ptr, d_pred_ptr, N, C);\n}"
