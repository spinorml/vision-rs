"pub fn sigmoid_focal_loss_forward < T : Triton, const BLOCK_N : i32 >\n(logits_ptr : T :: Pointer < f32 > , targets_ptr : T :: Pointer < f32 > ,\nloss_ptr : T :: Pointer < f32 > , N : i32, alpha : f32, gamma : f32, num_boxes\n: f32,) where T :: I32Tensor : types :: Tensor < i32, 1 > , T :: I32Tensor :\nComparison < i32, BoolTensor = T :: BoolTensor > , T :: Pointer < f32 > :\nAddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor < T :: Pointer < f32\n> > > ,\n{\n    let n_start = T :: program_id(Axis :: X) * BLOCK_N; let n_offs = T ::\n    arange(0, BLOCK_N) + n_start; let mask = n_offs.lt(N); let zeros = T ::\n    zeros :: < f32 > (& [BLOCK_N]); let ones = T :: full :: < f32 >\n    (& [BLOCK_N], 1.0_f32); let x = T ::\n    load(logits_ptr.add_offsets(n_offs), Some(mask), Some(zeros), & [], None,\n    None, None, false); let t = T ::\n    load(targets_ptr.add_offsets(n_offs), Some(mask), Some(zeros), & [], None,\n    None, None, false); let p = T :: sigmoid(x); let p_t = p * t + (ones - p)\n    * (ones - t); let alpha_t_val = T :: full :: < f32 > (& [BLOCK_N], alpha);\n    let one_minus_a = T :: full :: < f32 > (& [BLOCK_N], 1.0_f32 - alpha); let\n    alpha_t = alpha_t_val * t + one_minus_a * (ones - t); let one_minus_pt =\n    ones - p_t; let focal_weight = T ::\n    exp(T :: full :: < f32 > (& [BLOCK_N], gamma) * T ::\n    log(one_minus_pt + T :: full :: < f32 > (& [BLOCK_N], 1e-8))); let ce =\n    zeros - T :: log(p_t + T :: full :: < f32 > (& [BLOCK_N], 1e-8)); let loss\n    = alpha_t * focal_weight * ce / T :: full :: < f32 >\n    (& [BLOCK_N], num_boxes); T ::\n    store(loss_ptr.add_offsets(n_offs), loss, Some(mask), & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(logits_ptr: *mut f32, targets_ptr: *mut f32, loss_ptr: *mut f32, N: i32, alpha: f32, gamma: f32, num_boxes: f32) {\n    let logits_ptr = LlvmPointer(logits_ptr as *mut _);\n    let targets_ptr = LlvmPointer(targets_ptr as *mut _);\n    let loss_ptr = LlvmPointer(loss_ptr as *mut _);\n    sigmoid_focal_loss_forward::<LlvmTriton, 128>(logits_ptr, targets_ptr, loss_ptr, N, alpha, gamma, num_boxes);\n}"
