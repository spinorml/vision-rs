"pub fn dinov2_unpack_attn < T : Triton, const HEAD_DIM : i32 >\n(attn_ptr : T :: Pointer < f32 > , out_ptr : T :: Pointer < f32 > , n_ctx :\ni32, num_heads : i32, _bh_total : i32,) where T :: I32Tensor : Tensor < i32, 1\n> , T :: I32Tensor : Comparison < i32, BoolTensor = T :: BoolTensor > , T ::\nPointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor, Output = T :: Tensor <\nT :: Pointer < f32 > > > ,\n{\n    let pid = T :: program_id(Axis :: X); let d = T :: arange(0, HEAD_DIM);\n    let bh = pid / n_ctx; let n = pid - bh * n_ctx; let b = bh / num_heads;\n    let h = bh - b * num_heads; let src_base = bh * n_ctx * HEAD_DIM + n *\n    HEAD_DIM; let x = T ::\n    load(attn_ptr.add_offsets(d + src_base), None, None, & [], None, None,\n    None, false); let dst_base = b * n_ctx * num_heads * HEAD_DIM + n *\n    num_heads * HEAD_DIM + h * HEAD_DIM; T ::\n    store(out_ptr.add_offsets(d + dst_base), x, None, & [], None, None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(attn_ptr: *mut f32, out_ptr: *mut f32, n_ctx: i32, num_heads: i32, _bh_total: i32) {\n    let attn_ptr = LlvmPointer(attn_ptr as *mut _);\n    let out_ptr = LlvmPointer(out_ptr as *mut _);\n    dinov2_unpack_attn::<LlvmTriton, 32>(attn_ptr, out_ptr, n_ctx, num_heads, _bh_total);\n}"
