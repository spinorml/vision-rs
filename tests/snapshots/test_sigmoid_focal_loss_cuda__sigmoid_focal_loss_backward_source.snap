"pub fn sigmoid_focal_loss_backward < T : Triton, const BLOCK_N : i32 >\n(logits_ptr : T :: Pointer < f32 > , targets_ptr : T :: Pointer < f32 > ,\nd_loss_ptr : T :: Pointer < f32 > , d_logits_ptr : T :: Pointer < f32 > , N :\ni32, alpha : f32, gamma : f32, num_boxes : f32,) where T :: I32Tensor : types\n:: Tensor < i32, 1 > , T :: I32Tensor : Comparison < i32, BoolTensor = T ::\nBoolTensor > , T :: Pointer < f32 > : AddOffsets < i32, 1, T :: I32Tensor,\nOutput = T :: Tensor < T :: Pointer < f32 > > > ,\n{\n    let n_start = T :: program_id(Axis :: X) * BLOCK_N; let n_offs = T ::\n    arange(0, BLOCK_N) + n_start; let mask = n_offs.lt(N); let zeros = T ::\n    zeros :: < f32 > (& [BLOCK_N]); let ones = T :: full :: < f32 >\n    (& [BLOCK_N], 1.0_f32); let eps = T :: full :: < f32 >\n    (& [BLOCK_N], 1e-8_f32); let gamma_t = T :: full :: < f32 >\n    (& [BLOCK_N], gamma); let two = T :: full :: < f32 >\n    (& [BLOCK_N], 2.0_f32); let x = T ::\n    load(logits_ptr.add_offsets(n_offs), Some(mask), Some(zeros), & [], None,\n    None, None, false); let t = T ::\n    load(targets_ptr.add_offsets(n_offs), Some(mask), Some(zeros), & [], None,\n    None, None, false); let dy = T ::\n    load(d_loss_ptr.add_offsets(n_offs), Some(mask), Some(zeros), & [], None,\n    None, None, false); let p = T :: sigmoid(x); let p_t = p * t + (ones - p)\n    * (ones - t); let alpha_t = T :: full :: < f32 > (& [BLOCK_N], alpha) * t\n    + T :: full :: < f32 > (& [BLOCK_N], 1.0_f32 - alpha) * (ones - t); let\n    one_m_pt = ones - p_t; let log_pt = T :: log(p_t + eps); let focal_pow = T\n    :: exp(gamma_t * T :: log(one_m_pt + eps)); let d_ce = p - t; let d_pt_dx\n    = (two * t - ones) * p * (ones - p); let d_focal_dx = (zeros - gamma_t) *\n    T :: exp((gamma_t - ones) * T :: log(one_m_pt + eps)) * d_pt_dx; let nb =\n    T :: full :: < f32 > (& [BLOCK_N], num_boxes); let ce = zeros - log_pt;\n    let d_logits = dy * alpha_t / nb * (focal_pow * d_ce + ce * d_focal_dx); T\n    ::\n    store(d_logits_ptr.add_offsets(n_offs), d_logits, Some(mask), & [], None,\n    None);\n}\n\nuse triton::llvm::triton::num::*;\nuse triton::llvm::triton::pointer::LlvmPointer;\ntype LlvmTriton = triton::llvm::triton::LlvmTriton;\n\n#[no_mangle]\npub extern \"C\" fn entry_point(logits_ptr: *mut f32, targets_ptr: *mut f32, d_loss_ptr: *mut f32, d_logits_ptr: *mut f32, N: i32, alpha: f32, gamma: f32, num_boxes: f32) {\n    let logits_ptr = LlvmPointer(logits_ptr as *mut _);\n    let targets_ptr = LlvmPointer(targets_ptr as *mut _);\n    let d_loss_ptr = LlvmPointer(d_loss_ptr as *mut _);\n    let d_logits_ptr = LlvmPointer(d_logits_ptr as *mut _);\n    sigmoid_focal_loss_backward::<LlvmTriton, 128>(logits_ptr, targets_ptr, d_loss_ptr, d_logits_ptr, N, alpha, gamma, num_boxes);\n}"
